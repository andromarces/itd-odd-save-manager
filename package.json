{
  "name": "itd-odd-save-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "test": "vp test watch",
    "test:run": "vp test",
    "test:coverage": "vp test run --coverage",
    "lint": "oxlint --config .oxlintrc.json --report-unused-disable-directives-severity=error",
    "tauri": "tauri",
    "format": "pnpm run format:oxfmt && pnpm run format:rust",
    "format:check": "pnpm run format:oxfmt:check && pnpm run format:rust:check",
    "format:oxfmt": "node ./scripts/run-oxfmt-tracked.mjs",
    "format:oxfmt:check": "node ./scripts/run-oxfmt-tracked.mjs --check",
    "format:rust": "cd src-tauri && cargo fmt",
    "format:rust:check": "cd src-tauri && cargo fmt --all -- --check",
    "prepare": "node ./scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
